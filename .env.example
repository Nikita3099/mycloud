# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,cloud.reg.ru,194.67.122.61
DJANGO_LOG_LEVEL=INFO

# Администратор (создание: python manage.py create_default_admin)
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_FULL_NAME=Administrator

# --- База данных PostgreSQL (по умолчанию в system_config заданы типичные значения) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mycloud
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Файлы и загрузки ---
CLOUD_STORAGE_ROOT=
MAX_UPLOAD_BYTES=52428800
# Список расширений с точкой, через запятую; пусто или * — любые (ограничение только размером)
ALLOWED_UPLOAD_EXTENSIONS=*

# --- CSRF / CORS / сессии ---
CSRF_TRUSTED_ORIGINS=https://cloud.reg.ru,https://194.67.122.61

SESSION_COOKIE_SAMESITE=Lax
# Для SPA часто оставляют 0; для жёсткой защиты cookie — 1 (тогда csrftoken недоступен из JS)
CSRF_COOKIE_HTTPONLY=0

# --- Throttling DRF (опционально) ---
THROTTLE_USER=2000/day
THROTTLE_ANON=200/day
THROTTLE_UPLOAD=100/hour

# --- Frontend (сборка React) ---
REACT_APP_API_BASE=
